{
  "name": "hypeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free, open-source Twitch clipping that listens to chat. Browser-only, BYOK AI.",
  "homepage": "https://hypeline.live",
  "repository": {
    "type": "git",
    "url": "https://github.com/Angel-Casas/Hypeline.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && node scripts/spa-fallback.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && vue-tsc -b --noEmit",
    "format": "prettier --write .",
    "icons": "node scripts/render-icons.mjs",
    "icons:check": "node scripts/render-icons.mjs --check",
    "e2e": "node e2e/smoke.mjs && node e2e/cut.mjs && node e2e/ai.mjs && node e2e/search.mjs && node e2e/quota.mjs && node e2e/import.mjs && node e2e/live.mjs && node e2e/home.mjs && node e2e/subonly.mjs && node e2e/i18n.mjs && node e2e/support.mjs && node e2e/tour.mjs && node e2e/pinch.mjs && node e2e/pwa.mjs && node e2e/vocab.mjs && node e2e/emotion.mjs",
    "postinstall": "node scripts/copy-ffmpeg-core.mjs",
    "e2e:fixtures": "node scripts/fetch-e2e-segments.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "idb": "^8.0.3",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-i18n": "^11.4.12",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.55.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.13",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6"
  }
}
